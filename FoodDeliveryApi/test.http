}

### Get Customer Order History (Requires Customer JWT)
GET {{host}}/api/order/customer
Authorization: Bearer eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJzdWIiOiJiYTEyZjAyNi1iMTYxLTQwMGEtODQ0Mi01ZjBlZGQ0NzgyMTgiLCJlbWFpbCI6InRlc3RAZXhhbXBsZS5jb20iLCJodHRwOi8vc2NoZW1hcy5taWNyb3NvZnQuY29tL3dzLzIwMDgvMDYvaWRlbnRpdHkvY2xhaW1zL3JvbGUiOiJDdXN0b21lciIsImV4cCI6MTc4OTc0OTE5NywiaXNzIjoiRm9vZERlbGl2ZXJ5QXBpIiwiYXVkIjoiRm9vZERlbGl2ZXJ5Q2xpZW50In0.qI3U7r3PNfMAQkbsfOwO_BH-6IQUXnIs1xjoYkN-cMM

### Get Vendor Incoming Orders (Requires Vendor/Gordon JWT)
GET {{host}}/api/order/vendor
Authorization: Bearer eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..R1hCufmHcLnNO1hZIVptHuE-CoSatgLHEv3AjqL51JA

### Update Order Status to Accepted (Requires Vendor JWT)
PUT {{host}}/api/order/01a09150-a51e-7ab2-94b2-9f800fa71741/status
Content-Type: application/json
Authorization: Bearer eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..GN2_Jzi6dIRB4eLisvc75cAI6l3uZUpKplNoTrwHsoA

{
  "status": 1
}