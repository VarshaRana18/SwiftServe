@port = 5121
@host = http://localhost:{{port}}

### Register Customer
POST {{host}}/api/auth/register
Content-Type: application/json

{
  "email": "alice.customer@example.com",
  "password": "Password123!",
  "fullName": "Alice Customer",
  "roles": ["Customer"]
}


