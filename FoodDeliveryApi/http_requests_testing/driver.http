@port = 5121
@host = http://localhost:{{port}}

PUT {{host}}/api/order/01a09958-3ac1-71e3-a980-12ee33384caa/status
Authorization: Bearer eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..2NLwnQOEKe-WB2tMz6x2ZiTkzV1qFNHmhYE9OGN7ZLw
Content-Type: application/json

{ "status": 2 }


### Claim Order
PUT {{host}}/api/driver/01a11b6f-ccf1-7cfc-b9ad-6802c89372d0/claim
Authorization: Bearer eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..UmWGuqCPO0OjNE2IOc7RzyhRPga8Jc5MmM5YTR8oEts


### Update to Delivered
PUT {{host}}/api/driver/01a0b562-1bb0-744c-9d56-bfa047355713/status
Authorization: Bearer eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..UmWGuqCPO0OjNE2IOc7RzyhRPga8Jc5MmM5YTR8oEts
Content-Type: application/json

{ "status": 4 }

### Get Available Deliveries (Requires Driver JWT)
# # Fetches all orders where Status == 2 (Ready for Pickup) AND DriverId is null.
GET {{host}}/api/driver/available-orders
Authorization: Bearer eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..UmWGuqCPO0OjNE2IOc7RzyhRPga8Jc5MmM5YTR8oEts


### Get Driver Profile (Requires Driver JWT)
# Why: When the driver logs in or opens Settings, we need to check if they have a phone number.
GET {{host}}/api/driver/profile
Authorization: Bearer eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..Mgdmx5Q0J-smA2WI23CzhP9IvKcru-r26KAEmdbAamc


### Update Driver Profile / Phone Number (Requires Driver JWT)
# Why: When the driver enters their phone number in the mandatory prompt or Settings page, 
# save it to their AspNetUsers record.
PUT {{host}}/api/driver/profile
Authorization: Bearer eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..Mgdmx5Q0J-smA2WI23CzhP9IvKcru-r26KAEmdbAamc
Content-Type: application/json

{
  "phoneNumber": "+919876543217"
}


