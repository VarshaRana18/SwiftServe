#Added by Samiul
### Get Driver Delivery History (Requires Driver JWT)
# Why: Fetches all orders successfully delivered by this specific driver.
GET {{host}}/api/driver/history
Authorization: Bearer eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..lSChlffGk2u4p_3-OpbFC5YxXgkMfQGxwX_O26zMI0g

# EXPECTED RESPONSE FORMAT:
# [
#   {
#     "id": "01a135b5-...",
#     "restaurant": { "name": "Firehouse Grill" },
#     "updatedAt": "2026-10-18T14:41:26Z" // Used to show the delivery time
#   }
# ]

#NOTE FOR VARSHA : This endpoint should query the Orders table where DriverId == CurrentUserId AND Status == 4 (Delivered), ordered by date descending.