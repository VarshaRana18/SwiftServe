@port = 5121
@host = http://localhost:{{port}}


### Place an Order (Requires Customer JWT)
POST {{host}}/api/order
Content-Type: application/json
Authorization: Bearer eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..zXqbJ2T3VmL8RT9oSH2HSVjEgjAgQ2u7bh4KwU86YUI

{
  "restaurantId": "01a0b4ce-5993-74aa-84f1-e2159ca68238",
  "addressId":"01a0b529-9801-76bc-9dad-bdfe5b73c4fc",
  "items": [
    {
      "menuItemId": "01a11006-092d-7ba4-b9c1-4d305991ceb8",
      "quantity": 2
    }
  ]
}



### Get Customer Order History (Requires Customer JWT)
GET {{host}}/api/order/customer
Authorization: Bearer eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..tAgxo-XqM96x4C6wEw-g6mRD3p4x3_okJi6L0NHgyYw


### Get Vendor Incoming Orders (Requires Vendor/Gordon JWT)
GET {{host}}/api/order/vendor
Authorization: Bearer eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..tAgxo-XqM96x4C6wEw-g6mRD3p4x3_okJi6L0NHgyYw


### Get Restaurant Specific Orders for Vendor(Requires Vendor/Gordon JWT)
GET {{host}}/api/order/vendor/01a1109e-9460-7b5f-8197-524e4b58aeee
Authorization: Bearer eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..tAgxo-XqM96x4C6wEw-g6mRD3p4x3_okJi6L0NHgyYw


### Update Order Status to Accepted (Requires Vendor JWT)
PUT {{host}}/api/order/01a0994d-af7e-7c47-be16-883cc20f35aa/status
Content-Type: application/json
Authorization: Bearer eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..2NLwnQOEKe-WB2tMz6x2ZiTkzV1qFNHmhYE9OGN7ZLw

{
  "status": 1
}